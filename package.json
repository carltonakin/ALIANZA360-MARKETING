{
  "name": "alianza-crm-marketing-360",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/start-local.mjs",
    "build": "next build",
    "start": "node --env-file-if-exists=.env scripts/start-production.mjs",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/rendered-html.test.mjs tests/production-startup.test.mjs tests/mssql-conversion.test.mjs tests/social-config.test.mjs tests/social-core.test.mjs tests/social-intelligence.test.mjs tests/campaign-automation.test.mjs tests/sprout-adapter.test.mjs tests/buffer-integration.test.mjs tests/crm-orchestrator.test.mjs tests/social-api.test.mjs tests/social-sql.test.mjs tests/social-smoke.test.mjs",
    "test:social": "node --test tests/social-core.test.mjs tests/social-intelligence.test.mjs tests/campaign-automation.test.mjs tests/sprout-adapter.test.mjs tests/buffer-integration.test.mjs tests/crm-orchestrator.test.mjs tests/social-api.test.mjs tests/social-sql.test.mjs",
    "test:smoke": "node --test tests/social-smoke.test.mjs",
    "verify:social": "node scripts/verify-social.mjs",
    "start:social-listener": "node --env-file-if-exists=.env social/server.mjs",
    "start:smarterasp": "node --env-file-if-exists=.env scripts/start-production.mjs",
    "validate:smarterasp": "node scripts/validate-smarterasp.mjs",
    "security:scan": "node scripts/scan-tracked-secrets.mjs",
    "db:setup:mssql": "node --env-file-if-exists=.env scripts/setup-mssql.mjs",
    "test:mssql": "node --test tests/mssql-conversion.test.mjs tests/social-sql.test.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "db:test:mssql": "node --env-file-if-exists=.env scripts/test-mssql.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "cloudinary": "2.10.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mp4box": "2.4.1",
    "mssql": "^12.7.0",
    "multer": "^2.2.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-loading-skeleton": "3.5.0",
    "tailwindcss": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.2": true
  }
}
