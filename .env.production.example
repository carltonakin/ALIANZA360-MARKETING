NODE_ENV=production
SERVICE_AUTH_TOKEN=<strong-random-service-token>
SOCIAL_LISTENER_PORT=8788
DB_SERVER=<smarterasp-sql-server>
DB_PORT=1433
DB_NAME=<smarterasp-database-name>
DB_USER=<smarterasp-database-user>
DB_PASSWORD=<smarterasp-database-password>
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
CHANNEL_CONFIG_ENCRYPTION_KEY=<strong-random-encryption-key>
BUFFER_API_KEY=<buffer-api-key>
BUFFER_ORGANIZATION_ID=<buffer-organization-id>
BUFFER_API_URL=https://api.buffer.com
CAMPAIGN_MEDIA_DIRECTORY=App_Data/campaign-media
# Required public app origin. Buffer media URLs are built as
# PUBLIC_BASE_URL/uploads/campaigns/<stored-filename>.
PUBLIC_BASE_URL=https://<your-public-app-hostname>
CAMPAIGN_MEDIA_PUBLIC_PATH=/uploads/campaigns
CAMPAIGN_MEDIA_MAX_BYTES=314572800

# Optional alternative: use an independently deployed HTTPS listener instead.
# SOCIAL_LISTENER_SERVICE_URL=https://<your-listener-domain>
# SOCIAL_LISTENER_SERVICE_TOKEN=<matching-service-token>
