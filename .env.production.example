NODE_ENV=production
SERVICE_AUTH_TOKEN=<strong-random-service-token>
SOCIAL_LISTENER_PORT=8788
DB_SERVER=<smarterasp-sql-server>
DB_PORT=1433
DB_NAME=<smarterasp-database-name>
DB_USER=<smarterasp-database-user>
DB_PASSWORD=<smarterasp-database-password>
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
CHANNEL_CONFIG_ENCRYPTION_KEY=<strong-random-encryption-key>

# Optional alternative: use an independently deployed HTTPS listener instead.
# SOCIAL_LISTENER_SERVICE_URL=https://<your-listener-domain>
# SOCIAL_LISTENER_SERVICE_TOKEN=<matching-service-token>
