# Sites dashboard -> Social Listener service
SOCIAL_LISTENER_SERVICE_URL=
SOCIAL_LISTENER_SERVICE_TOKEN=
SOCIAL_LISTENER_ADMIN_EMAIL=
LOCAL_APP_PORT=3000

# Social Listener service
SERVICE_AUTH_TOKEN=
SOCIAL_LISTENER_PORT=8788
CAMPAIGN_AUTOMATION_INTERVAL_MS=60000
CAMPAIGN_AUTOMATION_BATCH_SIZE=10
SPROUT_ACTION_INTERVAL_MS=60000
SOCIAL_RAW_EVENT_RETENTION_DAYS=7
SQL_SERVER_CONNECTION_STRING=
DB_SERVER=localhost\SQLEXPRESS
# Leave DB_PORT empty for a named instance. SQL Server Browser resolves SQLEXPRESS to its TCP port.
# If you configure a fixed TCP port instead, use DB_SERVER=localhost and DB_PORT=1433 (or your actual port).
DB_PORT=
DB_NAME=CRMMarketingFunnel360
DB_USER=m360
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=yes
CHANNEL_CONFIG_ENCRYPTION_KEY=

# Sprout Social adapter (server only; never expose these values to the browser)
SPROUT_API_BASE_URL=https://api.sproutsocial.com
SPROUT_AUTH_MODE=api_token
SPROUT_CUSTOMER_ID=
SPROUT_GROUP_ID=
SPROUT_PROFILE_IDS=
SPROUT_LISTENING_TOPIC_IDS=
SPROUT_API_TOKEN=
# Recommended alternative for machine-to-machine production authentication:
SPROUT_CLIENT_ID=
SPROUT_CLIENT_SECRET=
SPROUT_OAUTH_TOKEN_URL=https://identity.sproutsocial.com/oauth2/84e39c75-d770-45d9-90a9-7b79e3037d2c/v1/token

# OpenAI Responses API (AI drafts are validated and saved as draft records)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Meta / Instagram / Facebook
META_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_APP_ID=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_WEBHOOK_URL=
META_CALLBACK_URL=
META_SCOPES=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
META_BUSINESS_ID=
META_GRAPH_API_VERSION=v23.0

# X
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_API_KEY=
X_API_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_WEBHOOK_SECRET=
X_WEBHOOK_URL=
X_CALLBACK_URL=
X_SCOPES=
