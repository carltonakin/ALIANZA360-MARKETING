# Optional external Social Listener. Local and single-app production launchers
# inject an internal loopback URL and matching token automatically.
SOCIAL_LISTENER_SERVICE_URL=
SOCIAL_LISTENER_SERVICE_TOKEN=
LOCAL_APP_PORT=3000

# Social Listener service
SERVICE_AUTH_TOKEN=
SOCIAL_LISTENER_PORT=8788
CAMPAIGN_AUTOMATION_INTERVAL_MS=60000
CAMPAIGN_AUTOMATION_BATCH_SIZE=10
SOCIAL_RAW_EVENT_RETENTION_DAYS=7
SQL_SERVER_CONNECTION_STRING=
DB_SERVER=localhost\SQLEXPRESS
# Leave DB_PORT empty for a named instance. SQL Server Browser resolves SQLEXPRESS to its TCP port.
# If you configure a fixed TCP port instead, use DB_SERVER=localhost and DB_PORT=1433 (or your actual port).
DB_PORT=
DB_NAME=CRMMarketingFunnel360
DB_USER=m360
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=yes
CHANNEL_CONFIG_ENCRYPTION_KEY=

# Buffer campaign publishing (server only; never use NEXT_PUBLIC_)
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_API_URL=https://api.buffer.com
# Cloudinary campaign media (server only; never use NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CAMPAIGN_FOLDER=crm-marketing/campaigns
# Optional signed upload preset. Leave empty when no preset is required.
CLOUDINARY_UPLOAD_PRESET=
CAMPAIGN_MEDIA_MAX_BYTES=314572800

# OpenAI Responses API (AI drafts are validated and saved as draft records)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional inbound Social Listener credentials (campaign publishing uses Buffer)
# Meta / Instagram / Facebook
META_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_APP_ID=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_WEBHOOK_URL=
META_CALLBACK_URL=
META_SCOPES=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
META_BUSINESS_ID=
META_GRAPH_API_VERSION=v23.0

# X
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_API_KEY=
X_API_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_WEBHOOK_SECRET=
X_WEBHOOK_URL=
X_CALLBACK_URL=
X_SCOPES=
